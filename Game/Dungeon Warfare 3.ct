[ENABLE]
aobscanmodule(INJECT,GameAssembly.dll,F3 0F 11 8F B0 00 00 00) // should be unique
alloc(newmem,$1000,INJECT)

label(code)
label(return)
label(maxgold)

newmem:

code:
  movss xmm1,[maxgold]       // xmm1 레지스터에 9999999.0 (Float) 값을 로드
  movss [rdi+000000B0],xmm1  // 메모리에 저장
  jmp return

align 16
maxgold:
  dd (float)9999999.0        // Float 형태로 9999999.0 정의

INJECT:
  jmp newmem
  nop 3
return:
registersymbol(INJECT)

